# These public Supabase values must be identical in the Cloudflare build
# environment and Worker runtime bindings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only; never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Migration-only secret for the same project; do not configure as a Worker binding.
SUPABASE_DB_URL=

# Paystack API base URL. The app defaults to this official endpoint.
PAYSTACK_BASE_URL=https://api.paystack.co
# Public by design; this server-hosted checkout flow does not use it.
PAYSTACK_PUBLIC_KEY=
# Configure this only as a server-side secret, never with a VITE_ prefix.
PAYSTACK_SECRET_KEY=
PAYMENT_ALLOWED_ORIGINS=https://bestplugmarketplace.shop
VITE_PAYMENT_GATEWAY_URL=https://bestplugmarketplace.shop
